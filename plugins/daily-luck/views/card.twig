{% if daily_luck %}
<div class="card card-outline card-info" id="daily-luck-card">
  <div class="card-header"><h2 class="card-title"><i class="fas fa-dice mr-1" aria-hidden="true"></i>{{ luck_settings.title }}</h2><div class="card-tools"><span class="text-muted small">{{ daily_luck.date }}</span></div></div>
  <div class="card-body">
    {% if luck_settings.display == 'reveal' %}
      {% if not daily_luck.opened %}<p class="text-muted">今天的冒险，会有怎样的好运？</p>{% endif %}
      <form method="post" action="{{ url('user/daily-luck/reveal') }}">{{ csrf_field() }}
        <button class="btn bg-gradient-primary pl-4 pr-4" type="submit" {% if daily_luck.opened %}disabled aria-disabled="true"{% endif %}><i class="fas fa-dice mr-1" aria-hidden="true"></i>{{ daily_luck.opened ? '明天再来看看？' : '查看今日人品' }}</button>
      </form>
    {% endif %}
    <div id="daily-luck-result" class="{{ luck_settings.display == 'reveal' ? 'mt-3' : '' }}" {{ luck_settings.display == 'reveal' and not daily_luck.opened ? 'hidden' : '' }}>
      <div class="d-flex align-items-center mb-2"><span class="display-4 text-{{ daily_luck.color }} mr-2">{{ daily_luck.score }}</span><span class="text-muted mr-3">/ 100</span><span class="badge badge-{{ daily_luck.color }}">{{ daily_luck.label }}</span></div>
      <p class="mb-2">{{ daily_luck.text }}</p>
    </div>
    <p class="text-muted small mb-0 mt-3">每天一份新好运 · {{ daily_luck.timezone }} 每日 00:00 更新</p>
  </div>
</div>
{% endif %}
