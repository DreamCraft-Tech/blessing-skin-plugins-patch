{% extends 'admin.base' %}
{% block title %}CDN 真实客户端地址{% endblock %}
{% block content %}
{% if session('cdn_real_ip.notice') %}<div class="alert alert-success" role="status">{{ session('cdn_real_ip.notice') }}</div>{% endif %}
{% if session('cdn_real_ip.error') %}<div class="alert alert-danger" role="alert">{{ session('cdn_real_ip.error') }}</div>{% endif %}
<div class="row">
<div class="col-md-6"><div class="card card-outline card-info"><div class="card-header"><h2 class="card-title">当前请求诊断</h2></div><div class="card-body">
<dl class="row mb-0"><dt class="col-sm-4">服务器连接地址</dt><dd class="col-sm-8"><code>{{ result.peer ?: '未提供' }}</code></dd><dt class="col-sm-4">解析后的客户端 IP</dt><dd class="col-sm-8"><code>{{ result.ip ?: '未提供' }}</code></dd><dt class="col-sm-4">请求协议</dt><dd class="col-sm-8">{{ result.scheme|upper }}</dd><dt class="col-sm-4">匹配规则</dt><dd class="col-sm-8">{{ result.provider ? profiles[result.provider].name : '服务器连接' }}</dd><dt class="col-sm-4">地址来源头</dt><dd class="col-sm-8">{{ result.ip_header ?: 'REMOTE_ADDR' }}</dd><dt class="col-sm-4">协议来源头</dt><dd class="col-sm-8">{{ result.proto_header ?: '回源连接' }}</dd><dt class="col-sm-4">处理结果</dt><dd class="col-sm-8">{{ result.message }}</dd></dl>
{% if result.scheme_note %}<p class="text-muted mt-2 mb-0">{{ result.scheme_note }}</p>{% endif %}
<details class="mt-3"><summary role="button">查看收到的地址与协议头</summary><dl class="mt-2 mb-0">{% for name,value in raw_headers %}<dt>{{ name }}</dt><dd><code style="overflow-wrap:anywhere">{{ value }}</code></dd>{% else %}<dd>当前请求未携带相关头部。</dd>{% endfor %}</dl></details>
</div></div></div>
<div class="col-md-6"><div class="card card-outline card-primary"><div class="card-header"><h2 class="card-title">腾讯云 CDN 接入</h2></div><div class="card-body"><p>腾讯云默认携带 <code>X-Forwarded-For</code> 和 <code>X-Forwarded-Proto</code>。填写回源 IP 段，或在 CDN 回源请求头中设置下方的回源验证值，即可识别客户端地址。</p><p>回源验证头：<code>X-Blessing-CDN-Auth</code>，取值与对应厂商卡片中保存的验证值一致。</p><p class="mb-0">回源地址可在腾讯云控制台查询，也可使用 <a target="_blank" rel="noopener" href="https://cloud.tencent.com/document/product/228/41954">DescribeIpStatus</a>，参数选择 <code>Layer=last</code>、<code>ShowIpv6=true</code>。</p></div></div></div>
</div>
<form method="post" action="{{ url('admin/cdn-real-ip/config') }}" id="cdn-real-ip-settings">{{ csrf_field() }}
<fieldset {{ not can_save ? 'disabled' : '' }}>
<div class="row"><div class="col-md-6"><div class="card card-outline card-primary"><div class="card-header"><h2 class="card-title">统一处理</h2></div><div class="card-body">
{% for key,label in {'enabled':'处理客户端地址','sync_scheme':'识别客户端请求协议'} %}<div class="form-group"><label for="cdn-{{ key }}">{{ label }}</label><select class="form-control" id="cdn-{{ key }}" name="{{ key }}"><option value="1" {{ attribute(settings,key) ? 'selected' : '' }}>开启</option><option value="0" {{ not attribute(settings,key) ? 'selected' : '' }}>关闭</option></select></div>{% endfor %}<p class="text-muted mb-0">统一用于 Laravel 请求、登录限流、登录记录及企业微信登录通知。</p>
</div></div></div><div class="col-md-6"><div class="card card-outline card-info"><div class="card-header"><h2 class="card-title">内部反向代理</h2></div><div class="card-body"><div class="form-group"><label for="cdn-local">可信的内部代理 IP / CIDR</label><textarea class="form-control text-monospace" id="cdn-local" name="local_proxies" rows="5" placeholder="填写实际使用的 OpenResty、负载均衡或容器代理地址">{{ settings.local_proxies }}</textarea></div><p class="text-muted mb-0">多层代理按连接方向逐层解析。每行一个地址或网段，也可用逗号分隔。</p></div></div></div></div>
<div class="row">
{% for id,profile in profiles %}{% set provider = settings.providers[id] %}
<div class="col-md-6"><div class="card card-outline {{ id == 'tencent' ? 'card-primary' : 'card-info' }}"><div class="card-header"><h2 class="card-title">{{ profile.name }}</h2></div><div class="card-body">
<div class="form-group"><label for="cdn-{{ id }}-enabled">接入状态</label><select class="form-control" id="cdn-{{ id }}-enabled" name="providers[{{ id }}][enabled]"><option value="1" {{ provider.enabled ? 'selected' : '' }}>启用</option><option value="0" {{ not provider.enabled ? 'selected' : '' }}>停用</option></select></div>
<p class="text-muted">客户端地址：<code>{{ id == 'custom' ? provider.ip_header : profile.ip }}</code><br>客户端协议：<code>{{ id == 'custom' ? provider.proto_header : profile.proto }}</code> · <a href="{{ profile.docs }}" target="_blank" rel="noopener">厂商说明</a></p>
<div class="form-group"><label for="cdn-{{ id }}-ranges">可信回源 IP / CIDR</label><textarea class="form-control text-monospace" id="cdn-{{ id }}-ranges" name="providers[{{ id }}][ranges]" rows="5" placeholder="每行一个 IPv4 / IPv6 地址或 CIDR 网段">{{ provider.ranges }}</textarea></div>
{% if id == 'cloudflare' %}<button type="button" class="btn btn-default mb-2" id="cdn-cloudflare-fetch" data-url="{{ url('admin/cdn-real-ip/cloudflare') }}">获取 Cloudflare 官方地址段</button><p id="cdn-cloudflare-status" class="text-muted small" role="status" aria-live="polite"></p>{% endif %}
<p class="text-muted small">地址列表：{{ provider.updated_at ?: '尚未保存' }}{{ provider.source == 'cloudflare' ? ' · Cloudflare 官方接口' : '' }}</p>
<div class="form-group"><label for="cdn-{{ id }}-token">回源验证值{{ provider.token_set ? '（已设置，留空保留）' : '（可选）' }}</label><div class="input-group"><input id="cdn-{{ id }}-token" name="tokens[{{ id }}]" class="form-control text-monospace" type="password" minlength="32" maxlength="128" autocomplete="new-password" placeholder="32–128 位字母、数字、下划线或短横线"><div class="input-group-append"><button type="button" class="btn btn-default" data-token-generate="{{ id }}">生成</button><button type="button" class="btn btn-default" data-token-show="{{ id }}">显示</button></div></div></div>
{% if provider.token_set %}<div class="form-check mb-3"><input id="cdn-{{ id }}-clear" class="form-check-input" type="checkbox" name="providers[{{ id }}][clear_token]" value="1"><label class="form-check-label" for="cdn-{{ id }}-clear">清除已保存的回源验证值</label></div>{% endif %}
{% if id == 'custom' %}<div class="form-group"><label for="cdn-custom-ip">客户端 IP 请求头</label><input class="form-control" id="cdn-custom-ip" name="providers[custom][ip_header]" value="{{ provider.ip_header }}" maxlength="80" required></div><div class="form-group"><label for="cdn-custom-mode">地址头格式</label><select class="form-control" id="cdn-custom-mode" name="providers[custom][ip_mode]"><option value="chain" {{ provider.ip_mode == 'chain' ? 'selected' : '' }}>代理链（从右向左解析）</option><option value="single" {{ provider.ip_mode == 'single' ? 'selected' : '' }}>单个客户端地址</option></select></div><div class="form-group"><label for="cdn-custom-proto">协议请求头</label><input class="form-control" id="cdn-custom-proto" name="providers[custom][proto_header]" value="{{ provider.proto_header }}" maxlength="80"></div>{% endif %}
<p class="text-muted small mb-0">IP 范围和回源验证值至少填写一项；同时填写时需同时匹配。验证值在 CDN 回源请求头中配置。</p>
</div></div></div>
{% endfor %}
</div><button type="submit" class="btn btn-primary mb-4">保存配置</button>
</fieldset></form>
{% if can_save %}<div class="card card-outline card-info"><div class="card-header"><h2 class="card-title">模拟解析</h2></div><div class="card-body"><form method="post" action="{{ url('admin/cdn-real-ip/simulate') }}">{{ csrf_field() }}<div class="form-row"><div class="form-group col-md-6"><label for="cdn-test-peer">服务器连接地址</label><input id="cdn-test-peer" class="form-control" name="peer" required placeholder="例如 CDN 回源节点 IP"></div><div class="form-group col-md-6"><label for="cdn-test-scheme">回源连接协议</label><select id="cdn-test-scheme" class="form-control" name="native_scheme"><option value="http">HTTP</option><option value="https">HTTPS</option></select></div></div><div class="form-group"><label for="cdn-test-headers">请求头（JSON）</label><textarea class="form-control text-monospace" id="cdn-test-headers" name="headers" rows="4" required>{"X-Forwarded-For":"203.0.113.25","X-Forwarded-Proto":"https"}</textarea></div><button type="submit" class="btn btn-default">模拟解析</button></form>
{% if simulation %}<div class="mt-3"><strong>模拟结果：</strong><code>{{ simulation.ip }}</code> · {{ simulation.scheme|upper }} · {{ simulation.message }}</div>{% endif %}</div></div>{% endif %}
{% endblock %}
{% block before_foot %}<script src="{{ url('plugins/cdn-real-ip/assets/config.js?v=1.0.0') }}" defer></script>{% endblock %}
