{% extends 'user.base' %}
{% block title %}企业微信绑定{% endblock %}
{% block content %}
<div class="row"><div class="col-lg-7">
  {% if session('wecom_error') %}<div class="alert alert-danger" role="alert">{{ session('wecom_error') }}</div>{% endif %}
  {% if session('wecom_notice') %}<div class="alert alert-success">{{ session('wecom_notice') }}</div>{% endif %}
  <div class="card card-outline card-success">
    <div class="card-header"><h2 class="card-title">登录与账号绑定</h2></div>
    <div class="card-body">
    {% if binding %}
      <p><span class="badge badge-success">已绑定</span> 你可以使用企业微信扫码登录当前账号。</p>
      <dl class="row">
        <dt class="col-sm-3">企业成员</dt><dd class="col-sm-9">{{ binding.member_name ?: '企业成员' }}</dd>
        <dt class="col-sm-3">成员账号</dt><dd class="col-sm-9">{{ binding.member_id }}</dd>
      </dl>
      <hr>
      <form method="post" action="{{ url('user/wecom/notifications') }}">
        {{ csrf_field() }}
        <div class="form-group">
          <label for="wecom-notification-mode">登录通知推送时机</label>
          <select id="wecom-notification-mode" class="form-control" name="notification_mode">
            <option value="strict" {{ notification_mode == 'strict' ? 'selected' : '' }}>严格：每次主动网页登录都推送</option>
            <option value="relaxed" {{ notification_mode == 'relaxed' ? 'selected' : '' }}>宽松：登录地变化较大时推送</option>
            <option value="off" {{ notification_mode == 'off' ? 'selected' : '' }}>关闭：不接收登录通知</option>
          </select>
          <small class="form-text text-muted">宽松模式使用本地城市库与在线定位复核；中国境内城市不同即提醒，境外相差至少 300 公里或跨国时提醒。首次定位、定位失败或结果冲突也会提醒。自动恢复会话和 Yggdrasil 游戏认证不推送。</small>
          <small class="form-text text-muted">宽松模式会将登录 IP 发送至 ipwho.is，成功定位缓存 24 小时。IP 地理位置仅供参考。</small>
          <small class="form-text text-muted"><a href="https://db-ip.com" target="_blank" rel="noopener noreferrer">IP Geolocation by DB-IP</a></small>
          {% if not geo_ready %}<small class="form-text text-warning">本地城市库尚未准备或已过期，宽松模式会按定位不确定发送提醒。</small>{% endif %}
        </div>
        {% if not notifications_enabled %}<p class="text-muted">管理员尚未开启消息推送；可以先保存偏好，开启后生效。</p>{% endif %}
        <button class="btn btn-outline-success" type="submit">保存通知设置</button>
      </form>
      <hr>
      <p>更换绑定前，请输入当前皮肤站密码解除原绑定。解绑不会删除皮肤站账号。</p>
      <form method="post" action="{{ url('user/wecom/unbind') }}">
        {{ csrf_field() }}
        <div class="form-group">
          <label for="wecom-password">皮肤站密码</label>
          <input id="wecom-password" class="form-control" type="password" name="password" required autocomplete="current-password" maxlength="1024">
        </div>
        <button class="btn btn-outline-danger" type="submit">验证密码并解绑</button>
      </form>
      <p class="text-muted mt-3">尚未设置皮肤站密码的账号，请先在个人资料中设置密码。</p>
    {% else %}
      <p>绑定后，使用企业微信扫码即可登录当前皮肤站账号。不会创建新账号，也不会更改你的邮箱或密码。</p>
      <p>同一个企业微信成员只能绑定一个皮肤站账号。请确认当前登录的是你要绑定的账号。</p>
      {% if ready %}
      <form method="post" action="{{ url('user/wecom/bind') }}">
        {{ csrf_field() }}
        <button class="btn btn-success" type="submit"><i class="fas fa-qrcode mr-1" aria-hidden="true"></i>扫码绑定企业微信</button>
      </form>
      {% else %}
      <div class="alert alert-warning">管理员尚未完成企业微信配置，请稍后再试。</div>
      {% endif %}
    {% endif %}
    </div>
  </div>
</div></div>
{% endblock %}
