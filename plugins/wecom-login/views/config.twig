{% extends 'admin.base' %}
{% block title %}企业微信登录配置{% endblock %}
{% block content %}
<div class="row"><div class="col-lg-8">
  {% if session('wecom_error') %}<div class="alert alert-danger" role="alert">{{ session('wecom_error') }}</div>{% endif %}
  {% if session('wecom_notice') %}<div class="alert alert-success">{{ session('wecom_notice') }}</div>{% endif %}
  <div class="card card-outline card-success">
    <div class="card-header"><h2 class="card-title">企业内部自建应用</h2></div>
    <div class="card-body">
      <p>连接企业微信自建应用，为皮肤站用户提供扫码登录、账号绑定和登录提醒。</p>
      <form method="post" action="{{ url('admin/wecom/config') }}">
        {{ csrf_field() }}
        <div class="form-group"><label for="wecom-corp">CorpID（企业 ID）</label>
          <input id="wecom-corp" class="form-control" name="corp_id" value="{{ corp_id }}" required maxlength="128" autocomplete="off"></div>
        <div class="form-group"><label for="wecom-agent">AgentID（自建应用 ID）</label>
          <input id="wecom-agent" class="form-control" name="agent_id" value="{{ agent_id }}" required pattern="[1-9][0-9]*" maxlength="20" inputmode="numeric" autocomplete="off"></div>
        <div class="form-group"><label for="wecom-redirect">完整回调 URL</label>
          <input id="wecom-redirect" class="form-control" type="url" name="redirect_uri" value="{{ redirect_uri }}" placeholder="https://skin.example.com/auth/wecom/callback" required maxlength="2048">
          <small class="text-muted">必须使用本站 HTTPS 域名，路径固定为 /auth/wecom/callback。</small></div>
        <div class="form-group"><label for="wecom-secret">应用 Secret</label>
          <input id="wecom-secret" class="form-control" type="password" name="secret" value="" maxlength="512" autocomplete="new-password" placeholder="留空保留当前 Secret">
          <small class="text-muted">当前状态：{{ secret_set ? '已设置' : '尚未设置或无法解密' }}；来源：{{ secret_source }}。</small></div>
        <div class="form-group form-check">
          <input id="wecom-use-env" class="form-check-input" type="checkbox" name="use_env_secret" value="1">
          <label class="form-check-label" for="wecom-use-env">使用环境变量 WECOM_SECRET 作为应用 Secret</label>
        </div>
        <div class="form-group form-check">
          <input id="wecom-notifications" class="form-check-input" type="checkbox" name="login_notifications_enabled" value="1" {{ login_notifications_enabled ? 'checked' : '' }}>
          <label class="form-check-label" for="wecom-notifications">允许发送网页登录通知</label>
          <small class="form-text text-muted">开启后，已绑定用户可选择每次登录提醒、异地登录提醒或关闭通知。</small>
        </div>
        <hr>
        <h3 class="h5">消息通知类型与样式</h3>
        <div class="form-row">
          <div class="form-group col-md-6"><label for="wecom-message-type">消息类型</label>
            <select id="wecom-message-type" class="form-control" name="message_type">
              {% for value,label in {'textcard':'卡片消息','text':'纯文本消息','markdown':'Markdown 消息'} %}<option value="{{ value }}" {{ message_type == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
            </select></div>
          <div class="form-group col-md-6"><label for="wecom-message-style">正文样式</label>
            <select id="wecom-message-style" class="form-control" name="message_style">
              {% for value,label in {'detailed':'详细：方式、IP、设备等','compact':'简洁：账号、时间、IP','custom':'自定义模板'} %}<option value="{{ value }}" {{ message_style == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
            </select></div>
        </div>
        <div class="form-row" id="wecom-card-fields">
          <div class="form-group col-md-8"><label for="wecom-message-title">卡片标题</label><input id="wecom-message-title" class="form-control" name="message_title" value="{{ message_title }}" required maxlength="80"></div>
          <div class="form-group col-md-4"><label for="wecom-message-button">卡片按钮文字</label><input id="wecom-message-button" class="form-control" name="message_button" value="{{ message_button }}" required maxlength="4"></div>
        </div>
        <div class="form-group" id="wecom-template-field"><label for="wecom-message-template">自定义正文模板</label>
          <textarea id="wecom-message-template" class="form-control" name="message_template" rows="7" required maxlength="2000">{{ message_template }}</textarea>
          <small class="text-muted">可用变量：<code>{reason}</code>、<code>{site_name}</code>、<code>{username}</code>、<code>{uid}</code>、<code>{login_time}</code>、<code>{login_method}</code>、<code>{ip}</code>、<code>{city}</code>、<code>{user_agent}</code>。选择“自定义模板”后使用此正文；Markdown 类型可在模板中使用 Markdown。</small>
        </div>
        <div class="border rounded p-3 mb-3 bg-light" aria-label="消息正文预览">
          <strong id="wecom-preview-title"></strong><pre id="wecom-preview-body" class="mt-2 mb-2" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre><span id="wecom-preview-button" class="text-success"></span>
          <small class="d-block text-muted mt-2">示例预览。卡片正文上限为 512 字节，文本及 Markdown 正文上限为 2048 字节。</small>
        </div>
        <button type="submit" class="btn btn-success">保存配置</button>
      </form>
      <hr>
      <h3 class="h5">IP 城市库管理</h3>
      <p>本地 IP 城市库：<strong id="wecom-geo-ready">{{ geo_ready ? '已准备' : '待更新' }}</strong>。宽松模式同时使用本地库与 ipwho.is 在线校验。</p>
      <div id="wecom-geo-panel" data-base="{{ url('admin/wecom/geoip') }}">
        <button type="button" id="wecom-geo-start" class="btn btn-outline-success">下载 / 更新城市库</button>
        <button type="button" id="wecom-geo-pause" class="btn btn-outline-secondary" hidden>暂停</button>
        <div id="wecom-geo-message" class="mt-3" role="status" aria-live="polite"></div>
        <div class="progress my-2" id="wecom-geo-progress-wrap" hidden><div id="wecom-geo-progress" class="progress-bar bg-success" role="progressbar" aria-valuemin="0" aria-valuemax="100" style="width:0%">0%</div></div>
      </div>
      <small class="d-block text-muted mt-2 mb-3">点击更新以获取最新城市定位数据。更新期间保持页面打开，暂停后可继续。建议每月更新。</small>
      <p><a href="https://db-ip.com" target="_blank" rel="noopener noreferrer">IP Geolocation by DB-IP</a>，本地数据采用 CC BY 4.0 许可。在线定位缓存有效期为 24 小时。</p>
      <p>应用 Secret：<strong>{{ secret_set ? '已设置' : '尚未设置' }}</strong></p>
      <p>也可以在网站 <code>.env</code> 中配置 <code>WECOM_SECRET</code>；修改环境配置后执行 <code>php artisan config:clear</code>。后台保存的 Secret 优先于环境变量。</p>
      <p>在企业微信管理后台启用自建应用的企业微信 Web 登录，配置授权回调域名、应用可见范围，以及调用接口的服务器可信 IP。</p>
      <p>配置后，用户可在“高级功能 → 企业微信绑定”菜单自行绑定。</p>
    </div>
  </div>
</div></div>
{% endblock %}

{% block before_foot %}
<script src="{{ url('plugins/wecom-login/assets/config.js?v=1.5.1') }}" defer></script>
{% endblock %}
