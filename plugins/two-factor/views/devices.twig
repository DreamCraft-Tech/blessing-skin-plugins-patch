<div class="card-body table-responsive p-0"><table class="table table-striped mb-0"><thead><tr><th>名称</th><th>最近使用</th><th>操作</th></tr></thead><tbody>{% for device in devices %}<tr><td><form method="post" action="{{ url('user/two-factor/devices/rename') }}" class="d-flex">{{ csrf_field() }}<input type="hidden" name="kind" value="{{ device_kind }}"><input type="hidden" name="id" value="{{ device.id }}"><input class="form-control mr-2" name="name" maxlength="80" value="{{ device.name }}" aria-label="设备名称" required><button type="submit" class="btn btn-default" {{ not recent ? 'disabled' : '' }}>保存</button></form></td><td>{{ device.last_used_at ?: '尚未使用' }}</td><td><form method="post" action="{{ url('user/two-factor/devices/remove') }}" data-security-confirm="移除“{{ device.name }}”后，此设备将不再用于此账号验证。确认移除？">{{ csrf_field() }}<input type="hidden" name="kind" value="{{ device_kind }}"><input type="hidden" name="id" value="{{ device.id }}"><button type="submit" class="btn btn-danger" {{ not recent ? 'disabled' : '' }}>移除</button></form></td></tr>{% else %}<tr><td colspan="3">尚未添加设备。</td></tr>{% endfor %}</tbody></table></div>
