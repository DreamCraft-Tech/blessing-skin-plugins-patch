{% extends 'auth.base' %}
{% block title %}两步验证{% endblock %}
{% block content %}
<h1 class="h4 text-center mb-3">两步验证</h1>
{% include 'Blessing\\TwoFactor::messages' %}
<p class="text-muted">请使用已添加的验证设备完成登录。</p>
<form method="post" action="{{ url('auth/two-factor/code') }}">
{{ csrf_field() }}
<div class="form-group"><label for="two-factor-code">{{ has_totp ? '验证码或恢复码' : '恢复码' }}</label><input id="two-factor-code" class="form-control" name="current_password" autocomplete="one-time-code" maxlength="64" required autofocus></div>
<button class="btn btn-primary btn-block" type="submit">验证并登录</button>
</form>
{% if has_passkey %}<button type="button" class="btn btn-default btn-block mt-3" data-passkey-purpose="challenge"><i class="fas fa-key mr-1" aria-hidden="true"></i>使用通行密钥验证</button>{% endif %}
<form method="post" action="{{ url('auth/two-factor/cancel') }}" class="mt-3 text-center">{{ csrf_field() }}<button type="submit" class="btn btn-link">返回登录</button></form>
{% endblock %}
{% block before_foot %}<script data-base="{{ url('/') }}" src="{{ url('plugins/two-factor/assets/passkeys.js?v=1.0.0') }}" defer></script>{% endblock %}
